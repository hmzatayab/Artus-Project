// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId                    String    @unique
  username                  String?   @unique @map("username") @db.String
  name                      String
  email                     String    @unique
  password                  String    @default("") @map("password") @db.String
  isEmailVerified           Boolean   @default(false)
  emailVerificationToken    String?
  ipAddress                 String?   @default("")
  country                   String?   @default("")
  city                      String?   @default("")
  image                     String    @default("")
  followers                 String[]  @default([]) @db.ObjectId
  following                 String[]  @default([]) @db.ObjectId
  bio                       String    @default("")
  totalImagesSold           Int       @default(0)
  totalEarnings             Int       @default(0)
  totalEntryFeesPaid        Int       @default(0)
  prizePoolEarnings         Int       @default(0)
  totalAuctionsParticipated Int       @default(0)
  exclusiveBadges           String[]  @default([])
  totalAuctionsWon          Int       @default(0)
  wonPosts                  String[]  @default([]) @db.ObjectId
  featuredInTopAuctions     Boolean   @default(false)
  bidCount                  Int       @default(0) // Total bids user ne place ki hain
  vipTier                   String    @default("Bronze") // Current VIP level
  freeBids                  Int       @default(0) // Free bids jo user ko mil sakti hain
  auctionFeeDiscount        Float     @default(0) // Auction fees discount percentage
  exclusiveAccess           Boolean   @default(false) // Kya user ko exclusive auctions ka access hai?
  referralCode              String    @default("") // Unique referral code
  referredBy                String[]  @default([]) @db.ObjectId // Jisne is user ko refer kiya
  isLive                    Boolean   @default(false)
  walletIsActive            Boolean   @default(false)
  emailVerified             Boolean   @default(false)
  isBlocked                 Boolean   @default(false)
  wallet                    Wallet?
  passwordResetToken        String?   @db.String
  passwordResetTokenExpiry  DateTime?
  identityVerified          Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  posts                 Post[]
  comments              Comment[]
  replies               Reply[]
  auctions              Auction[]      @relation(name: "AuctionSeller")
  highestBids           Auction[]      @relation(name: "AuctionHighestBidder")
  wonAuctions           Auction[]      @relation(name: "AuctionWinner")
  receivedNotifications Notification[] @relation(name: "ReceiverNotifications")
  sentNotifications     Notification[] @relation(name: "SenderNotifications")
  Bid                   Bid[]
}

model Admin {
  id                       String    @id @default(auto()) @map("_id") @db.ObjectId
  adminId                  String    @unique
  passcode                 String
  name                     String
  email                    String    @unique
  password                 String    @default("") @map("password") @db.String
  image                    String    @default("")
  isEmailVerified          Boolean   @default(false)
  emailVerificationToken   String?
  walletIsActive           Boolean   @default(false)
  role                     String    @default("Editor")
  isBlocked                Boolean   @default(false)
  passwordResetToken       String?   @db.String
  passwordResetTokenExpiry DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model Post {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  userId               String   @db.ObjectId
  title                String
  description          String
  tags                 String[]
  likes                String[] @default([]) @db.ObjectId
  isLikedByCurrentUser Boolean  @default(false)
  imageURL             String
  Status               String
  isLive               Boolean  @default(false)
  isAuctioned          Boolean  @default(false)
  auctionId            String?  @db.ObjectId
  OwnerId              String?  @db.ObjectId
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comment[]
  auction  Auction[]
}

model Comment {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  postId               String   @db.ObjectId
  userId               String   @db.ObjectId
  content              String
  likes                String[] @default([]) @db.ObjectId
  isLikedByCurrentUser Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies Reply[]
}

model Reply {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  commentId            String   @db.ObjectId
  userId               String   @db.ObjectId
  content              String
  likes                String[] @default([]) @db.ObjectId
  isLikedByCurrentUser Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id                        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId                    String    @unique @db.ObjectId
  balance                   Float     @default(0)
  walletId                  String    @unique
  isActive                  Boolean   @default(false)
  cashbackBalance           Float     @default(0)
  totalCashbackEarned       Float     @default(0)
  usedCashback              Float     @default(0)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  failedTransactionCount    Float     @default(0)
  lastFailedTransactionTime DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  walletId      String   @db.ObjectId
  type          String // 'deposit', 'withdraw', 'transfer'
  amount        Float
  transactionId String   @unique
  invoiceId     String   @unique
  fromUserId    String?  @db.ObjectId
  toUserId      String?  @db.ObjectId
  status        String // 'success', 'failed', 'pending'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  receiverId String   @db.ObjectId
  senderId   String   @db.ObjectId
  type       String // message, follow, like, comment, etc.
  message    String
  link       String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  receiver User @relation(name: "ReceiverNotifications", fields: [receiverId], references: [id])
  sender   User @relation(name: "SenderNotifications", fields: [senderId], references: [id])

  @@index([receiverId])
  @@index([senderId])
}

model Auction {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  postId          String   @db.ObjectId
  sellerId        String   @db.ObjectId
  startingPrice   Float
  highestBid      Float    @default(0)
  highestBidderId String?  @db.ObjectId
  winnerId        String?  @db.ObjectId
  status          String   @default("active") // "active", "ended", "completed"
  startTime       DateTime @default(now())
  endTime         DateTime
  bids            Bid[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seller        User  @relation(name: "AuctionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  highestBidder User? @relation(name: "AuctionHighestBidder", fields: [highestBidderId], references: [id], onDelete: SetNull)
  winner        User? @relation(name: "AuctionWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  post          Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Bid {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  auctionId String   @db.ObjectId
  userId    String   @db.ObjectId
  amount    Float
  timestamp DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
