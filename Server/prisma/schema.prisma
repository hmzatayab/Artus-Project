// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  username         String?  @unique @map("username") @db.String
  name             String
  email            String   @unique
  password         String   @default("") @map("password") @db.String
  image            String   @default("")
  followers        String[] @default([])
  following        String[] @default([])
  bio              String   @default("")
  totalImagesSold  Int      @default(0)
  totalEarnings    Int      @default(0)
  isLive           Boolean  @default(false)
  walletIsActive   Boolean  @default(false)
  emailVerified    Boolean  @default(false)
  identityVerified Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
